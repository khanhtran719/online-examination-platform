# Opt in only after every API/source/DLQ image supports purged COMPLETED identity.
# This is a finite scheduled job, not an always-on service. Dedicated LOGIN required.
NODE_ENV=development
ASSESSMENT_RETENTION_ENABLED=false
ASSESSMENT_RETENTION_RECEIPT_BATCH=500
ASSESSMENT_RETENTION_ATTEMPT_BATCH=10
DATABASE_URL=postgres://assessment_maintenance:local-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=1
DB_MAX_WAITING=1
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
