# Dedicated function-only audit-maintenance LOGIN; production secret/TLS required.
# One finite batch, default-off. Scheduling cadence needs measured backlog/storage load.
NODE_ENV=development
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_BATCH=500
DATABASE_URL=postgres://audit_maintenance:local-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=1
DB_MAX_WAITING=1
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
