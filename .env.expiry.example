# Deadline sweep only. No JWT private key, CSRF key, email key or mail adapter.
NODE_ENV=development
DATABASE_URL=postgres://examination_expiry_local:local-expiry-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=2
DB_MAX_WAITING=4
DB_ACQUIRE_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=500
DB_IDLE_TRANSACTION_TIMEOUT_MS=5000
DB_SSL=false
EXPIRY_POLL_INTERVAL_MS=5000
EXPIRY_BATCH_SIZE=50
EXPIRY_JITTER_PERCENT=20
EXPIRY_BACKOFF_INITIAL_MS=200
EXPIRY_BACKOFF_MAX_MS=30000
EXPIRY_HEALTH_PORT=3017
