# Example region/queue only; this does not select an AWS account or provision SQS.
# Use dedicated dispatcher credentials. No JWT, password hash or email secrets.
NODE_ENV=development
DATABASE_URL=postgres://examination_dispatch_local:local-dispatch-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=2
DB_MAX_WAITING=4
DB_ACQUIRE_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=500
DB_IDLE_TRANSACTION_TIMEOUT_MS=5000
DB_SSL=false
AWS_REGION=ap-southeast-1
SUBMISSION_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/submissions
DISPATCH_CONCURRENCY=4
DISPATCH_TIMEOUT_MS=5000
DISPATCH_LEASE_MS=15000
DISPATCH_MAX_ATTEMPTS=10
DISPATCH_MAX_AGE_MS=86400000
DISPATCH_BACKOFF_INITIAL_MS=1000
DISPATCH_BACKOFF_MAX_MS=30000
DISPATCH_POLL_INTERVAL_MS=1000
DISPATCH_HEALTH_PORT=3018
