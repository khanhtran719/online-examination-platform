# Local host development only; fake credentials, never use in production.
# Database/migration options work now; API/worker entry points remain pending.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://examination_app_local:local-runtime-only-password@127.0.0.1:55432/examination
DATABASE_MIGRATION_URL=postgres://examination_migrator_local:local-migration-only-password@127.0.0.1:55432/examination
TEST_DATABASE_ADMIN_URL=postgres://examination:local-only-password@127.0.0.1:55432/examination
# LOCAL/TEST admin URL never goes into an application container or production secrets.
DB_POOL_MAX=10
DB_MAX_WAITING=20
DB_ACQUIRE_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=500
DB_IDLE_TRANSACTION_TIMEOUT_MS=5000
# Local candidates only: choose production pools from the connection budget and load evidence.
DB_SSL=false
DB_CA_FILE=
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/scoring
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
WORKER_CONCURRENCY=4
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05
LOG_LEVEL=info
