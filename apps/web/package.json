{
  "name": "@exam/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --mode demo",
    "dev:live": "vite --host 127.0.0.1 --port 5173 --mode live",
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode live",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --mode live",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4173 --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:identity:https": "playwright test --config playwright.identity-https.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
