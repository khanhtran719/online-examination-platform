# Example only. Provision SQS + encrypted DLQ and dedicated grading DB login first.
NODE_ENV=development
DATABASE_URL=postgres://examination_grading_local:local-grading-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=2
DB_MAX_WAITING=4
DB_ACQUIRE_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=500
DB_IDLE_TRANSACTION_TIMEOUT_MS=5000
DB_SSL=false
AWS_REGION=ap-southeast-1
SUBMISSION_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/submissions
GRADING_DLQ_ARN=arn:aws:sqs:ap-southeast-1:123456789012:grading-dlq
GRADING_CONCURRENCY=2
GRADING_WAIT_SECONDS=10
GRADING_TIMEOUT_MS=15000
GRADING_VISIBILITY_SECONDS=60
GRADING_HEARTBEAT_MS=10000
GRADING_MAX_RECEIVE_COUNT=5
GRADING_HEALTH_PORT=3019
