# Illustrative local-only dedicated recovery LOGIN; never a grading/Identity/owner LOGIN.
NODE_ENV=development
DATABASE_URL=postgres://examination_recovery:local-replace-password@127.0.0.1:55432/examination
DB_POOL_MAX=2
AWS_REGION=ap-southeast-1
SUBMISSION_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/submissions
GRADING_DLQ_ARN=arn:aws:sqs:ap-southeast-1:123456789012:submissions-dlq
GRADING_QUEUE_MODE=dead-letter
GRADING_HEALTH_PORT=3020
# Use scoped role-based AWS credentials outside this file. Local SDK override is loopback-only.
