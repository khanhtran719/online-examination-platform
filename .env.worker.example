# Separate local worker configuration; intentionally no JWT private/public or CSRF key paths.
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgres://examination_mail_local:local-mail-only-password@127.0.0.1:55432/examination
DB_POOL_MAX=4
DB_SSL=false
EMAIL_KEYS_FILE=.local/identity/email-keys.json
RATE_KEY_FILE=.local/identity/rate.key
MAIL_ADAPTER=smtp
MAIL_FROM=no-reply@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
WORKER_CONCURRENCY=2
